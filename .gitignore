# Dados brutos do data room: não sobem para o repositório (só a pasta, via .gitkeep)
dados/brutos/*
!dados/brutos/.gitkeep

# Dados processados: arquivos grandes, recriados pelos scripts de src/ (ver D-050)
dados/processados/*
!dados/processados/.gitkeep

# Material do case (enunciado e dicionário em PDF): fica só na máquina de cada um
docs/case/

# Chaves de API e configurações locais
.env
.env.*

# Ambiente Python
.venv/
venv/
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Sistema e editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
